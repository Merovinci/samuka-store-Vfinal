# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ir pro Git (já está no .gitignore).
# ---------------------------------------------------------------------------

# Banco de dados (SQL Server / Azure SQL Database recomendado p/ Vercel)
DB_SERVER=seu-servidor.database.windows.net
DB_NAME=samuka_store
DB_USER=usuario_do_banco
DB_PASSWORD=troque_por_uma_senha_forte_e_unica
DB_PORT=1433

# Autenticação — gere uma string aleatória longa (ex: openssl rand -hex 32)
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui

# CORS — domínio(s) do seu site publicado, separados por vírgula.
# NUNCA use "*" em produção (permitiria qualquer site chamar sua API).
ALLOWED_ORIGIN=https://samukastore.vercel.app

# Usados SOMENTE pelo script "npm run seed:admin" (o servidor não lê isso)
ADMIN_USERNAME=defina_um_usuario_admin
# ADMIN_PASSWORD=   deixe comentado para gerar uma senha aleatória forte
